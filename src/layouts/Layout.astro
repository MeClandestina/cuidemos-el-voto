---
import PostHog from '../components/posthog.astro';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="cream" data-hero="1" data-phase="1">
  <head>
    <meta charset="utf-8" />

    <PostHog />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-32T4QQL6B2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-32T4QQL6B2');
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={lang === 'en'
      ? "Citizen campaign to cover transport for rural Colombian voters to reach the polls. Donate now and make every vote count."
      : "Campaña ciudadana para cubrir el transporte de votantes rurales hacia los puestos de votación. Dona ahora y haz que cada voto cuente."} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={lang === 'en' ? "Protect the Vote · Imprenta Republicana" : "Cuidemos el Voto · Imprenta Republicana"} />
    <meta property="og:description" content={lang === 'en'
      ? "Citizen campaign to cover transport for rural Colombian voters to reach the polls. Donate now and make every vote count."
      : "Campaña ciudadana para cubrir el transporte de votantes rurales hacia los puestos de votación. Dona ahora y haz que cada voto cuente."} />
    <meta property="og:image" content={lang === 'en' ? "https://imprentarepublicana.co/assets/OGEN.jpg" : "https://imprentarepublicana.co/assets/og.jpg"} />
    <meta property="og:url" content={lang === 'en' ? "https://imprentarepublicana.co/en/" : "https://imprentarepublicana.co"} />
    <meta property="og:locale" content={lang === 'en' ? "en_US" : "es_CO"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={lang === 'en' ? "Protect the Vote · Imprenta Republicana" : "Cuidemos el Voto · Imprenta Republicana"} />
    <meta name="twitter:description" content={lang === 'en'
      ? "Citizen campaign to cover transport for rural Colombian voters to reach the polls. Donate now and make every vote count."
      : "Campaña ciudadana para cubrir el transporte de votantes rurales hacia los puestos de votación. Dona ahora y haz que cada voto cuente."} />
    <meta name="twitter:image" content={lang === 'en' ? "https://imprentarepublicana.co/assets/OGEN.jpg" : "https://imprentarepublicana.co/assets/og.jpg"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Special+Elite&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Courier+Prime:wght@400;700&family=Yellowtail&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <title>{title}</title>
    {lang === 'es' && (
      <script is:inline>
        if (!sessionStorage.getItem('lang_chosen') && !/^es/i.test(navigator.language)) {
          sessionStorage.setItem('lang_chosen', '1');
          window.location.replace('/en/');
        }
      </script>
    )}
  </head>
  <body>

    <!-- SVG ink filter -->
    <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true">
      <filter id="inkrough" x="-6%" y="-6%" width="112%" height="112%">
        <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="4" result="warp" />
        <feDisplacementMap in="SourceGraphic" in2="warp" scale="4.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="nav" id="nav">
      <a class="brand" href="#top" aria-label="Imprenta Republicana — inicio">
        <span class="brand__mark"><span class="star"></span></span>
        <span class="brand__name"><b>Imprenta</b><span>Republicana</span></span>
      </a>
      <nav class="nav__links" id="navLinks">
        {lang === 'en' ? (
          <a href="#about">About</a>
          <a href="#transparency" class="nav__cta" style="border:2px solid var(--ink);background:var(--accent);color:var(--crema);padding:8px 14px;">&#9733; Results</a>
          <a href="#transparency">Transparency</a>
          <a href="#requests">Requests</a>
          <a href="#contact">Contact</a>
          <a href="/" style="font-size:11px;opacity:.7;" onclick="sessionStorage.setItem('lang_chosen','1')">ES</a>
        ) : (
          <a href="#que-es">Qué es</a>
          <a href="#transparencia" class="nav__cta" style="border:2px solid var(--ink);background:var(--accent);color:var(--crema);padding:8px 14px;">&#9733; Cuentas</a>
          <a href="#transparencia">Transparencia</a>
          <a href="#solicitar">Solicitudes</a>
          <a href="#contacto">Contacto</a>
          <a href="/en/" style="font-size:11px;opacity:.7;" onclick="sessionStorage.setItem('lang_chosen','1')">EN</a>
        )}
      </nav>
      <div style="display:flex;align-items:center;gap:8px;">
        {lang === 'en' ? (
          <a class="nav__cta" href="#transparency" style="display:none;" id="mobileDonate">&#9733; Results</a>
        ) : (
          <a class="nav__cta" href="#transparencia" style="display:none;" id="mobileDonate">&#9733; Cuentas</a>
        )}
        <button class="nav__burger" id="burger" aria-label="Menu">Menu</button>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="footer" id="footer">
      <div class="wrap">
        <div class="footer__top">
          <div class="footer__brand">
            <div class="footer__logo ink-cream">Imprenta<br>Republicana</div>
            <p>Populares y digitales</p>
          </div>
          <div class="footer__cols">
            {lang === 'en' ? (
              <div class="footer__col">
                <h4>Campaign</h4>
                <a href="#about">About</a>
                <a href="#donations">Donations</a>
                <a href="#transparency">Transparency</a>
                <a href="#requests">Requests</a>
              </div>
              <div class="footer__col">
                <h4>Follow us</h4>
                <a href="https://www.instagram.com/imprentarepublicana" target="_blank" rel="noopener">Instagram</a>
              </div>
              <div class="footer__col">
                <h4>Language</h4>
                <a href="/" onclick="sessionStorage.setItem('lang_chosen','1')">Español</a>
              </div>
            ) : (
              <div class="footer__col">
                <h4>Campaña</h4>
                <a href="#que-es">Qué es</a>
                <a href="#donaciones">Donaciones</a>
                <a href="#transparencia">Transparencia</a>
                <a href="#solicitar">Solicitudes</a>
              </div>
              <div class="footer__col">
                <h4>Síguenos</h4>
                <a href="https://www.instagram.com/imprentarepublicana" target="_blank" rel="noopener">Instagram</a>
              </div>
              <div class="footer__col">
                <h4>Idioma</h4>
                <a href="/en/" onclick="sessionStorage.setItem('lang_chosen','1')">English</a>
              </div>
            )}
          </div>
        </div>
        <hr class="footer__rule" />
        <div class="footer__bottom">
          <span>&copy; 2026 Imprenta Republicana &middot; imprentarepublicana.co</span>
          <span>Cada peso cuenta &middot; made with ❤️ by <a href="https://www.instagram.com/unpocodesur" target="_blank" rel="noopener" style="text-decoration:underline;">@unpocodesur</a></span>
        </div>
      </div>
    </footer>

    <style>
      #mobileDonate { display:none !important; }
      @media (max-width:880px) {
        #mobileDonate { display:inline-flex !important; }
      }
    </style>
    <script is:inline src="/scripts/cv-main.js"></script>
  </body>
</html>
