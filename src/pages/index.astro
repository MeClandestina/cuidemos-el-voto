---
import Layout from '../layouts/Layout.astro';
import { getLatestTransparency, formatCOP } from '../data/fetchSheet';
import {
  SHOW_PHASE2_METRICS,
  INSTAGRAM_URL,
  WHATSAPP_URL,
} from '../data/config';

const data = await getLatestTransparency();
const primeraVuelta = 29136000;
const segundaVuelta = 250759368;
const totalDosVueltas = primeraVuelta + segundaVuelta;

function formatCO(n: number): string {
  return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}
---

<Layout title="Cuidemos el Voto · Imprenta Republicana">

<!-- ================= HERO ================= -->
<section class="hero regmark" id="hero">
  <div class="hero__deco" aria-hidden="true">
    <span class="star s1"></span><span class="star s2"></span><span class="star s3"></span>
  </div>
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__copy">
        <div class="deco-rule"><span class="dl"></span><span class="lbl"><span class="star"></span> 21 de junio &middot; Segunda vuelta <span class="star"></span></span><span class="dl dl--r"></span></div>
        <h1 class="hero__title ink-fx">
          <span class="l1">Cuidemos el</span>
          <span class="l2">VOTO</span>
          <span class="l3"><span class="tiny">de las</span> PERIFERIAS</span>
        </h1>
        <span class="hero__flourish">para que nadie se quede sin votar</span>
        <p class="hero__sub">En la Colombia rural, miles de personas quieren votar pero los puestos de votación quedan a horas de distancia — por río, por trocha, por montaña. Muchos colectivos simplemente no pueden llegar sin ayuda.</p>
        <div class="hero__actions">
          <a class="btn" href="#transparencia"><span class="star"></span> Ver las cuentas</a>
          <a class="btn btn--ghost" href="#solicitar">Solicitudes recibidas</a>
        </div>
        <div class="hero__meta">
          <span>Segunda vuelta &middot; <b>21 jun 2026</b></span>
          <span>Más de <b>45.000</b> personas a votar</span>
          <span>Cada peso &rarr; <b>transporte</b></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= RESULTADO FINAL ================= -->
<section class="cd-band" id="resultado-band" aria-label="Total recaudado en las dos vueltas">
  <div class="wrap cd-inner">
    <div class="cd-head">
      <div class="deco-rule"><span class="dl"></span><span class="lbl"><span class="star"></span> Lo logramos <span class="star"></span></span><span class="dl dl--r"></span></div>
      <p class="cd-title ink-cream">Recaudado en las dos vueltas</p>
    </div>
    <div class="tr__big" style="color:var(--crema);-webkit-text-fill-color:var(--crema);text-align:center;line-height:1.05;">
      <span class="cur" style="color:var(--crema);-webkit-text-fill-color:var(--crema);">$</span>{formatCO(totalDosVueltas)}
    </div>
    <p class="cd-note">Primera vuelta <strong>$29.136.000</strong> &middot; segunda vuelta <strong>$250.759.368</strong> &mdash; gracias a cada persona que aportó para que las periferias llegaran a votar.</p>
  </div>
</section>

<!-- ================= QUE ES ================= -->
<section class="section" id="que-es">
  <div class="wrap">
    <div class="que__grid">
      <div class="que__body reveal">
        <div class="section__head">
          <span class="kicker">Qué es &middot; Por qué</span>
          <h2 class="section__title ink-dark">Que la distancia <span class="script">no decida</span> la elección</h2>
        </div>
        <p>En muchas veredas y corregimientos, el puesto de votación más cercano queda a horas de camino: una lancha por el río, una chiva por la trocha, una moto que cobra lo que muchas familias no tienen un domingo de elecciones.</p>
        <p><strong>Cuidemos el Voto</strong> es una iniciativa ciudadana de Imprenta Republicana. Reunimos donaciones y las convertimos en transporte para que los colectivos de las periferias lleguen a las urnas el <strong>21 de junio</strong>.</p>
      </div>
      <div class="que__photo photo-bare reveal" data-d="1">
        <img src="/assets/buseta.jpg" alt="Buseta rural repleta de personas camino al puesto de votación" width="1152" height="912" />
      </div>
    </div>

    <div class="stat-band reveal">
      <div class="stat">
        <div class="stat__num ink-red" data-prefix="+" data-count="45000">0</div>
        <div class="stat__lbl">Personas llegaron a votar &middot; las dos vueltas</div>
      </div>
      <div class="stat">
        <div class="stat__num ink-red" data-count="3742">0</div>
        <div class="stat__lbl">Solo en la primera vuelta</div>
      </div>
      <div class="stat">
        <div class="stat__num ink-red" data-prefix="+" data-count="166">0</div>
        <div class="stat__lbl">Colectivos pidieron apoyo</div>
      </div>
    </div>
    <p class="tr__note" style="text-align:center">Gracias a cada donación, más de <strong>45.000 personas</strong> de las periferias de Colombia pudieron llegar a votar en las dos vueltas &mdash; empezando por 3.742 en la primera y multiplicándose en la segunda.</p>
    <p class="reveal" style="text-align:center;margin-top:10px;"><a href="https://razonpublica.com/la-imprenta-republicana-las-vacas-la-democracia/" target="_blank" rel="noopener"><span class="star"></span> Razón Pública escribió sobre esta iniciativa &rarr;</a></p>
    <div style="text-align:center;margin-top:18px;">
      <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener"><span class="star"></span> Ver fotos y soportes de primera vuelta</a>
    </div>
  </div>
</section>

<!-- ================= CÓMO SE RECIBIERON LAS DONACIONES ================= -->
<section class="section section--alt" id="donaciones">
  <div class="wrap">
    <div class="section__head reveal">
      <span class="kicker">Cómo se recibieron las donaciones</span>
      <h2 class="section__title ink-dark">La recolección <span class="script">ya cerró</span></h2>
    </div>
    <p class="lead reveal" style="max-width:760px;">Las donaciones se recibieron a través de <strong>Nequi</strong>, <strong>transferencia bancaria (Zelle)</strong> y <strong>GoFundMe</strong> para quienes aportaron desde el exterior. La recolección ya está cerrada.</p>
    <p class="donar__intl reveal"><span class="star"></span> ¿Tienes preguntas? Escríbenos por DM en Instagram <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@imprentarepublicana</a>.</p>
  </div>
</section>

<!-- ================= TRANSPARENCIA ================= -->
<section class="section" id="transparencia">
  <div class="wrap">
    <div class="section__head reveal" style="text-align:center">
      <span class="kicker" style="justify-content:center">Transparencia</span>
      <h2 class="section__title ink-dark">Las cuentas, <span class="script">a la luz</span></h2>
    </div>

    <div class="tr__panel regmark reveal">
      <div class="tr__label">Total recaudado &middot; segunda vuelta</div>
      <div class="tr__big ink-red">
        <span class="cur">$</span><span id="recaudado" data-count={data.totalRecaudado.toString()}>{formatCO(data.totalRecaudado)}</span>
      </div>
      <div class="tr__sub">pesos colombianos &middot; <b>cifra final de la segunda vuelta</b></div>

      <div class="tr__meta">
        <div class="m"><div class="n" id="lastUpdate">{data.fecha}</div><div class="t">Última actualización</div></div>
        <div class="m"><div class="n">$279.895.368</div><div class="t">Total en las dos vueltas</div></div>
      </div>

      <div class="tr__actions">
        <a class="btn" href="https://drive.google.com/drive/folders/1bK9pwD6OEtDSFgXwvkyXi7SXMWq0vbRm" target="_blank" rel="noopener"><span class="star"></span> Informe segunda vuelta &middot; 21 de junio</a>
        <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener">Informe primera vuelta (PDF)</a>
        <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener">Fotos y soportes en Drive</a>
        <a class="btn btn--ghost" href="https://docs.google.com/spreadsheets/d/1orrl3OXyw5KRxZVZosZyfMw9_tBehXo-WNRspVWS0bc/edit?gid=0#gid=0" target="_blank" rel="noopener">Ver reporte diario de donaciones</a>
      </div>
      <p class="tr__note">Los informes y la carpeta de Drive incluyen las fotos de los colectivos llegando a votar en primera y segunda vuelta y los soportes de cada gasto. Los datos se publican desde una hoja de cálculo de Google.</p>
    </div>
  </div>
</section>

<!-- ================= SOLICITUDES RECIBIDAS ================= -->
<section class="section section--alt" id="solicitar">
  <div class="wrap">
    <div class="section__head reveal" style="text-align:center">
      <span class="kicker" style="justify-content:center">Solicitudes recibidas</span>
      <h2 class="section__title ink-dark">Más de <span class="script">166 colectivos</span> ya pidieron apoyo</h2>
    </div>
    <p class="lead reveal" style="text-align:center;max-width:760px;margin:0 auto;">Por ahora cerramos la recepción de solicitudes: tenemos <strong>más de 166 peticiones</strong> de comunidades de las periferias que necesitan transporte para llegar a votar.</p>
    <p class="reveal" style="text-align:center;max-width:760px;margin:14px auto 0;">Estamos revisando cada caso y corroborando la información. Iremos compartiendo los detalles a medida que avancemos con los datos.</p>
    <p class="sol__seal reveal" style="text-align:center;justify-content:center;margin-top:18px;"><span class="star"></span> ¿Tienes preguntas? Escríbenos por DM en Instagram <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@imprentarepublicana</a></p>
  </div>
</section>

<!-- ================= CONTACTO ================= -->
<section class="section contacto" id="contacto">
  <div class="wrap">
    <span class="kicker solo" style="justify-content:center">Contacto</span>
    <h2 class="contacto__title reveal ink-dark">El pueblo se cuida en <span class="script">colectivo.</span></h2>
    <div class="contacto__links reveal" data-d="1">
      <a class="cta-link" href={INSTAGRAM_URL} target="_blank" rel="noopener"><span class="ic">&#9678;</span> @imprentarepublicana</a>
    </div>
    <div class="star-divider" style="margin-top:46px"><span class="star"></span><span class="star"></span><span class="star"></span></div>
  </div>
</section>

<script is:inline>
// Live fetch from Google Sheet — updates transparency number on every page load
(function(){
  var SHEET_CSV = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vRCBWtEHOpbJu9dDqUwqUKhkGAVmhMg09YpwwEHCIX-DmpALsRyvqx5KHzYs1vVEuWaYVbE8yuezwIl/pub?output=csv&_=' + Date.now();
  function fmtCO(n){ return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.'); }
  fetch(SHEET_CSV).then(function(r){ return r.text(); }).then(function(csv){
    var rows = csv.trim().split('\n');
    if(rows.length < 2) return;
    // Handle quoted CSV fields (Google Sheets wraps numbers with commas in quotes)
    var last = rows[rows.length - 1];
    var cols = [];
    var inQuote = false, field = '';
    for(var i=0;i<last.length;i++){
      var c = last[i];
      if(c==='"'){ inQuote=!inQuote; }
      else if(c===','&&!inQuote){ cols.push(field); field=''; }
      else { field+=c; }
    }
    cols.push(field);
    var fecha = (cols[0]||'').trim();
    var raw = (cols[1]||'0').trim().split('.')[0].replace(/[^\d]/g,'');
    var total = parseInt(raw, 10);
    if(!total) return;
    var el = document.getElementById('recaudado');
    if(el){ el.setAttribute('data-count', total); el.dataset.done = ''; el.textContent = fmtCO(total); }
    var dateEl = document.getElementById('lastUpdate');
    if(dateEl && fecha) dateEl.textContent = fecha;
  }).catch(function(){});
})();
</script>

<script is:inline>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') { fn(); } else { document.addEventListener('DOMContentLoaded', fn); }
  }

  onReady(function () {
    // donate_cta_clicked — hero "Donar ahora" and nav "Donar" buttons
    document.querySelectorAll('a[href="#donar"].btn, a.nav__cta[href="#donar"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('donate_cta_clicked', { location: el.classList.contains('nav__cta') ? 'nav' : 'hero' });
      });
    });

    // gofundme_clicked — GoFundMe external link
    var gofundmeLink = document.querySelector('a[href*="gofundme.com"]');
    if (gofundmeLink) {
      gofundmeLink.addEventListener('click', function () {
        window.posthog?.capture('gofundme_clicked');
      });
    }

    // support_form_opened — "Abrir formulario" button in the Solicitar Apoyo section
    var formLinks = document.querySelectorAll('#solicitar a.btn, #solicitar a#formBtn');
    formLinks.forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('support_form_opened');
      });
    });

    // transparency_report_opened — links to Drive, PDF report, or Google Sheets in the transparency section
    document.querySelectorAll('#transparencia a[href], .que__body a[href*="drive.google.com"]').forEach(function (el) {
      el.addEventListener('click', function () {
        var href = el.getAttribute('href') || '';
        var doc_type = href.includes('spreadsheets') ? 'google_sheets' : href.includes('drive.google') ? 'google_drive' : 'other';
        window.posthog?.capture('transparency_report_opened', { doc_type: doc_type, url: href });
      });
    });

    // contact_instagram_clicked — Instagram contact links
    document.querySelectorAll('a[href*="instagram.com"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('contact_instagram_clicked', { location: el.closest('section')?.id || 'unknown' });
      });
    });
  });
})();
</script>

</Layout>
