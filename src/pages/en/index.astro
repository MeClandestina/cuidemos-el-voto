---
import Layout from '../../layouts/Layout.astro';
import { getLatestTransparency } from '../../data/fetchSheet';
import { INSTAGRAM_URL } from '../../data/config';

const data = await getLatestTransparency();
const primeraVuelta = 29136000;
const segundaVuelta = 250759368;
const totalDosVueltas = primeraVuelta + segundaVuelta;

function formatCO(n: number): string {
  return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}
---

<Layout title="Protect the Vote · Imprenta Republicana" lang="en">

<!-- ================= HERO ================= -->
<section class="hero regmark" id="hero">
  <div class="hero__deco" aria-hidden="true">
    <span class="star s1"></span><span class="star s2"></span><span class="star s3"></span>
  </div>
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__copy">
        <div class="deco-rule"><span class="dl"></span><span class="lbl"><span class="star"></span> June 21 &middot; Runoff election <span class="star"></span></span><span class="dl dl--r"></span></div>
        <h1 class="hero__title ink-fx">
          <span class="l1">Protect the</span>
          <span class="l2" style="margin-bottom:-0.08em;">VOTE</span>
          <span class="l3" style="margin-top:-0.05em;"><span class="tiny">in rural</span> COLOMBIA</span>
        </h1>
        <span class="hero__flourish" style="margin-bottom:-8px;">so no one is left without voting</span>
        <p class="hero__sub" style="margin-top:0;">In rural Colombia, thousands want to vote but polling stations are hours away — by river, by dirt road, by mountain trail. Many communities simply can't reach the polls without help. Help them cast their vote.</p>
        <div class="hero__actions">
          <a class="btn" href="#transparency"><span class="star"></span> See the numbers</a>
          <a class="btn btn--ghost" href="#about">Learn more</a>
        </div>
        <div class="hero__meta">
          <span>Runoff election &middot; <b>21 Jun 2026</b></span>
          <span>Over <b>45,000</b> people to the polls</span>
          <span>Every peso &rarr; <b>transport</b></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= FINAL RESULT ================= -->
<section class="cd-band" id="result-band" aria-label="Total raised across both rounds">
  <div class="wrap cd-inner">
    <div class="cd-head">
      <div class="deco-rule"><span class="dl"></span><span class="lbl"><span class="star"></span> We did it <span class="star"></span></span><span class="dl dl--r"></span></div>
      <p class="cd-title ink-cream">Raised across both rounds</p>
    </div>
    <div class="tr__big" style="color:var(--crema);-webkit-text-fill-color:var(--crema);text-align:center;line-height:1.05;">
      <span class="cur" style="color:var(--crema);-webkit-text-fill-color:var(--crema);">$</span>{formatCO(totalDosVueltas)}
    </div>
    <p class="cd-note">First round <strong>$29,136,000</strong> &middot; runoff <strong>$250,759,368</strong> COP &mdash; thanks to everyone who chipped in so rural communities could reach the polls.</p>
  </div>
</section>

<!-- ================= ABOUT ================= -->
<section class="section" id="about">
  <div class="wrap">
    <div class="que__grid">
      <div class="que__body reveal">
        <div class="section__head">
          <span class="kicker">What &middot; Why</span>
          <h2 class="section__title ink-dark">Distance shouldn't <span class="script">decide</span> an election</h2>
        </div>
        <p>In many rural villages across Colombia, the nearest polling station is hours away &mdash; a boat down the river, a bus through unpaved roads, a motorbike ride that costs more than a family can spare on election day.</p>
        <p><strong>Cuidemos el Voto</strong> (Protect the Vote) is a citizen-led initiative by Imprenta Republicana. We collect donations and turn them into transport so rural communities can reach the polls on <strong>June 21</strong>.</p>
      </div>
      <div class="que__photo photo-bare reveal" data-d="1">
        <img src="/assets/buseta.jpg" alt="Packed rural bus on the way to the polling station" width="1152" height="912" />
      </div>
    </div>

    <div class="stat-band reveal">
      <div class="stat">
        <div class="stat__num ink-red" data-prefix="+" data-count="45000">0</div>
        <div class="stat__lbl">People made it to the polls &middot; both rounds</div>
      </div>
      <div class="stat">
        <div class="stat__num ink-red" data-count="3742">0</div>
        <div class="stat__lbl">In the first round alone</div>
      </div>
      <div class="stat">
        <div class="stat__num ink-red" data-prefix="+" data-count="166">0</div>
        <div class="stat__lbl">Communities requested support</div>
      </div>
    </div>
    <p class="tr__note" style="text-align:center">Thanks to every donation, more than <strong>45,000 people</strong> from rural Colombia were able to reach the polls across both rounds &mdash; starting with 3,742 in the first and multiplying in the runoff.</p>
    <p class="reveal" style="text-align:center;margin-top:10px;"><a href="https://razonpublica.com/la-imprenta-republicana-las-vacas-la-democracia/" target="_blank" rel="noopener"><span class="star"></span> Razón Pública wrote about this initiative &rarr;</a></p>
    <div style="text-align:center;margin-top:18px;">
      <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener"><span class="star"></span> See first-round photos &amp; receipts</a>
    </div>
  </div>
</section>

<!-- ================= HOW DONATIONS WERE COLLECTED ================= -->
<section class="section section--alt" id="donations">
  <div class="wrap">
    <div class="section__head reveal">
      <span class="kicker">How donations were collected</span>
      <h2 class="section__title ink-dark">Fundraising <span class="script">is now closed</span></h2>
    </div>
    <p class="lead reveal" style="max-width:760px;">Donations were received through <strong>Nequi</strong>, <strong>bank transfer (Zelle)</strong> and <strong>GoFundMe</strong> for supporters abroad. Fundraising is now closed.</p>
    <p class="donar__intl reveal"><span class="star"></span> Questions? DM us on Instagram <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@imprentarepublicana</a>.</p>
  </div>
</section>

<!-- ================= TRANSPARENCY ================= -->
<section class="section" id="transparency">
  <div class="wrap">
    <div class="section__head reveal" style="text-align:center">
      <span class="kicker" style="justify-content:center">Transparency</span>
      <h2 class="section__title ink-dark">Full accountability, <span class="script">always</span></h2>
    </div>

    <div class="tr__panel regmark reveal">
      <div class="tr__label">Total raised &middot; runoff</div>
      <div class="tr__big ink-red">
        <span class="cur">$</span><span id="recaudado" data-count={data.totalRecaudado.toString()}>{formatCO(data.totalRecaudado)}</span>
      </div>
      <div class="tr__sub">Colombian pesos &middot; <b>final runoff figure</b></div>

      <div class="tr__meta">
        <div class="m"><div class="n" id="lastUpdate">{data.fecha}</div><div class="t">Last updated</div></div>
        <div class="m"><div class="n">$279,895,368</div><div class="t">Total across both rounds</div></div>
      </div>

      <div class="tr__actions">
        <a class="btn" href="https://drive.google.com/drive/folders/1bK9pwD6OEtDSFgXwvkyXi7SXMWq0vbRm" target="_blank" rel="noopener"><span class="star"></span> Second-round report &middot; June 21</a>
        <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener">First-round report</a>
        <a class="btn btn--ghost" href="https://drive.google.com/drive/folders/1XG48D1fr45MqMtTPUabJA3Pxybs-tIiK" target="_blank" rel="noopener">Photos &amp; receipts on Drive</a>
        <a class="btn btn--ghost" href="https://docs.google.com/spreadsheets/d/1orrl3OXyw5KRxZVZosZyfMw9_tBehXo-WNRspVWS0bc/edit?gid=0#gid=0" target="_blank" rel="noopener">Daily donation report</a>
      </div>
      <p class="tr__note">The reports and Drive folder include photos of communities arriving to vote in the first and second rounds and receipts for every expense. Data is published from a Google spreadsheet.</p>
    </div>
  </div>
</section>

<!-- ================= REQUESTS RECEIVED ================= -->
<section class="section section--alt" id="requests">
  <div class="wrap">
    <div class="section__head reveal" style="text-align:center">
      <span class="kicker" style="justify-content:center">Requests received</span>
      <h2 class="section__title ink-dark">Over <span class="script">166 communities</span> have asked for help</h2>
    </div>
    <p class="lead reveal" style="text-align:center;max-width:760px;margin:0 auto;">We've closed request intake for now: we already have <strong>more than 166 requests</strong> from rural communities that need transport to reach the polls.</p>
    <p class="reveal" style="text-align:center;max-width:760px;margin:14px auto 0;">We're reviewing each case and corroborating the information. We'll be sharing the details as we work through the data.</p>
    <p class="sol__seal reveal" style="text-align:center;justify-content:center;margin-top:18px;"><span class="star"></span> Questions? DM us on Instagram <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@imprentarepublicana</a></p>
  </div>
</section>

<!-- ================= CONTACT ================= -->
<section class="section contacto" id="contact">
  <div class="wrap">
    <span class="kicker solo" style="justify-content:center">Contact</span>
    <h2 class="contacto__title reveal ink-dark">The people look after <span class="script">each other.</span></h2>
    <div class="contacto__links reveal" data-d="1">
      <a class="cta-link" href={INSTAGRAM_URL} target="_blank" rel="noopener"><span class="ic">&#9678;</span> @imprentarepublicana</a>
    </div>
    <div class="star-divider" style="margin-top:46px"><span class="star"></span><span class="star"></span><span class="star"></span></div>
  </div>
</section>

<script is:inline>
// Live fetch from Google Sheet
(function(){
  var SHEET_CSV = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vRCBWtEHOpbJu9dDqUwqUKhkGAVmhMg09YpwwEHCIX-DmpALsRyvqx5KHzYs1vVEuWaYVbE8yuezwIl/pub?output=csv&_=' + Date.now();
  function fmtCO(n){ return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'.'); }
  fetch(SHEET_CSV).then(function(r){ return r.text(); }).then(function(csv){
    var rows = csv.trim().split('\n');
    if(rows.length < 2) return;
    var last = rows[rows.length - 1];
    var cols = [];
    var inQuote = false, field = '';
    for(var i=0;i<last.length;i++){
      var c = last[i];
      if(c==='"'){ inQuote=!inQuote; }
      else if(c===','&&!inQuote){ cols.push(field); field=''; }
      else { field+=c; }
    }
    cols.push(field);
    var fecha = (cols[0]||'').trim();
    var raw = (cols[1]||'0').trim().split('.')[0].replace(/[^\d]/g,'');
    var total = parseInt(raw, 10);
    if(!total) return;
    var el = document.getElementById('recaudado');
    if(el){ el.setAttribute('data-count', total); el.dataset.done = ''; el.textContent = fmtCO(total); }
    var dateEl = document.getElementById('lastUpdate');
    if(dateEl && fecha) dateEl.textContent = fecha;
  }).catch(function(){});
})();
</script>

<script is:inline>
(function () {
  function onReady(fn) {
    if (document.readyState !== 'loading') { fn(); } else { document.addEventListener('DOMContentLoaded', fn); }
  }

  onReady(function () {
    // donate_cta_clicked — hero "Donate now" button
    document.querySelectorAll('a[href="#donate"].btn').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('donate_cta_clicked', { location: 'hero', lang: 'en' });
      });
    });

    // gofundme_clicked
    var gofundmeLink = document.querySelector('a[href*="gofundme.com"]');
    if (gofundmeLink) {
      gofundmeLink.addEventListener('click', function () {
        window.posthog?.capture('gofundme_clicked', { lang: 'en' });
      });
    }

    // transparency_report_opened
    document.querySelectorAll('#transparency a[href], a[href*="drive.google.com"]').forEach(function (el) {
      el.addEventListener('click', function () {
        var href = el.getAttribute('href') || '';
        var doc_type = href.includes('spreadsheets') ? 'google_sheets' : href.includes('drive.google') ? 'google_drive' : 'other';
        window.posthog?.capture('transparency_report_opened', { doc_type: doc_type, url: href, lang: 'en' });
      });
    });

    // contact_instagram_clicked
    document.querySelectorAll('a[href*="instagram.com"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('contact_instagram_clicked', { location: el.closest('section')?.id || 'unknown', lang: 'en' });
      });
    });
  });
})();
</script>

</Layout>
